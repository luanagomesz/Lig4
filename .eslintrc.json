{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "error",
    "prefer-const": "warn",
    "no-var": "warn"
  },
  "globals": {
    "game": "writable",
    "player1": "writable",
    "player2": "writable",
    "counterDisco": "writable",
    "selecionado1": "writable",
    "selecionado2": "writable",
    "escolherJogadores": "readonly",
    "resetar": "readonly"
  }
}
